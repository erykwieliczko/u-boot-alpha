# Experimental fixed-hub host only. No gadget or Type-C policy takeover.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_HID=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_PHY_APPLE_J700_REPEATER=y
CONFIG_I2C=y
CONFIG_I2C_APPLE=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_GPIOLIB=y
CONFIG_COMMON_CLK=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_DEBUG_FS=y
