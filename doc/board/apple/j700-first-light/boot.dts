/* Experimental single-CPU Linux extension to our tested U-Boot handoff. */
#include "arch/arm/dts/t8140-j700.dts"
#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        cpu@0 {
            compatible = "apple,tahiti";
            device_type = "cpu";
            /* Filled from MPIDR_EL1 by m1n1; not an ADT logical CPU ID. */
            reg = <0 0>;
        };
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupt-parent = <&aic>;
        interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
        interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
                     <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
                     <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
                     <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
    };
};

&{/soc} {
    /* Captured J700 ADT: config 0x10000, iack 0x40000, stride 0x4a00;
     * cap0/max IRQ registers 4/12. Same register layout as the existing AIC3.
     */
    aic: interrupt-controller@301000000 {
        compatible = "apple,t8140-aic3", "apple,t8122-aic3";
        reg = <3 0x01000000 0 0x40000>, <3 0x01040000 0 0x4000>;
        interrupt-controller;
        #interrupt-cells = <3>;
        #address-cells = <0>;
    };

	mtp_dc: dockchannel@314b14000 {
		compatible = "apple,t8140-dockchannel", "apple,dockchannel";
		reg = <3 0x14b14000 0 0x4000>;
		reg-names = "irq";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1137 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;
		#address-cells = <0>;
	};
};

&mtp_mbox {
	interrupt-parent = <&aic>;
	interrupts = <AIC_IRQ 1152 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1153 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1154 IRQ_TYPE_LEVEL_HIGH>,
		     <AIC_IRQ 1155 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
};

&mtp_dart {
	interrupt-parent = <&aic>;
	interrupts = <AIC_IRQ 1135 IRQ_TYPE_LEVEL_HIGH>;
	apple,dma-range = <0x100 0x4000 0 0xffff0000>;
};

&mtp_hid {
	interrupt-parent = <&mtp_dc>;
	interrupts = <2 IRQ_TYPE_LEVEL_HIGH>, <3 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "tx", "rx";
	iommus = <&mtp_dart 0>;
	apple,no-stm;
};
