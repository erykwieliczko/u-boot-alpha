if ARCH_APPLE

config TEXT_BASE
	default 0x00000000

config SYS_SOC
	default "apple"

config SYS_VENDOR
	default "apple"

config SYS_BOARD
	string "Board name"
	default "mac"
	help
	  This option contains information about board name.
	  Based on this option board/<CONFIG_SYS_VENDOR>/<CONFIG_SYS_BOARD> will
	  be used.
	  Apple silicon based devices are expected to use the generic board name
	  "mac".

config SYS_MALLOC_LEN
	default 0x4000000

config SYS_MALLOC_F_LEN
	default 0x4000

config LNX_KRNL_IMG_TEXT_OFFSET_BASE
	default TEXT_BASE

config WDT_APPLE_PRESERVE_INHERITED_STATE
	bool "Preserve inherited Apple watchdog state"
	depends on WDT_APPLE
	help
	  On supported Apple machines, treat the live watchdog reset-enable bit
	  inherited from the previous boot stage as the sole automated-boot policy.
	  An inherited disabled watchdog remains disabled. An inherited enabled
	  watchdog receives bounded U-Boot and Linux handoff leases without generic
	  cyclic servicing.

config APPLE_PRELOADED_EFI
	bool "Boot an EFI payload appended to U-Boot"
	depends on EFI_LOADER
	help
	  Enable the diagnostic RAM-only EFI boot path. If the incoming device
	  tree contains u-boot,preloaded-efi-address and
	  u-boot,preloaded-efi-size properties in /chosen, U-Boot reserves and
	  starts that image without probing storage. This is intended for early
	  platform and EFI console bring-up.

config APPLE_HANDOFF
	bool
	default y if WDT_APPLE_PRESERVE_INHERITED_STATE || USB_DWC3_APPLE_HANDOFF

endif
